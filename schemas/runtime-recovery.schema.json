{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PREOS Runtime Recovery Records",
  "$defs": {
    "fileBinding": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "gitFile": {
      "type": "object",
      "required": ["status", "path", "sha256"],
      "properties": {
        "status": {"type": "string"},
        "path": {"type": "string"},
        "old_path": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"]}
      }
    },
    "gitSnapshot": {
      "type": "object",
      "required": ["repo_root", "branch", "head", "working_tree", "working_tree_fingerprint", "clean"],
      "properties": {
        "repo_root": {"type": "string"},
        "branch": {"type": "string"},
        "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "working_tree": {"type": "array", "items": {"$ref": "#/$defs/gitFile"}},
        "working_tree_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "clean": {"type": "boolean"}
      }
    },
    "checkpoint": {
      "type": "object",
      "required": ["schema_version", "checkpoint_id", "checkpoint_kind", "project_id", "updated_at", "current_stage", "git"],
      "properties": {
        "schema_version": {"enum": ["1.0", "1.1"]},
        "checkpoint_id": {"type": "string"},
        "checkpoint_kind": {"enum": ["SOFT", "HARD"]},
        "project_id": {"type": "string"},
        "updated_at": {"type": "string"},
        "current_stage": {"type": "string"},
        "blueprint_phase": {"type": ["string", "null"]},
        "preos_phase": {"type": ["string", "null"]},
        "gstack_specialist_stage": {"type": ["string", "null"]},
        "implementation_status": {"type": ["string", "null"]},
        "release_status": {"type": ["string", "null"]},
        "project_contract_version": {"type": ["string", "null"]},
        "task_packet_id": {"type": ["string", "null"]},
        "last_verified_action": {"type": ["string", "null"]},
        "next_unverified_action": {"type": ["string", "null"]},
        "pending_test": {"type": ["string", "null"]},
        "pending_build": {"type": ["string", "null"]},
        "pending_migration": {"type": ["string", "null"]},
        "pending_evidence": {"type": ["string", "null"]},
        "required_approval_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "bindings": {
          "type": "object",
          "properties": {
            "project_contract": {"$ref": "#/$defs/fileBinding"},
            "task_packet": {"$ref": "#/$defs/fileBinding"}
          }
        },
        "git": {"$ref": "#/$defs/gitSnapshot"}
      }
    },
    "approval": {
      "type": "object",
      "required": ["approval_id", "approval_type", "scope", "status", "authority", "updated_at"],
      "properties": {
        "approval_id": {"type": "string"},
        "approval_type": {"type": "string"},
        "scope": {"type": "string"},
        "status": {"enum": ["PENDING", "GRANTED", "DENIED"]},
        "authority": {"type": "string"},
        "rationale": {"type": "string"},
        "updated_at": {"type": "string"}
      }
    },
    "recoveryResult": {
      "type": "object",
      "required": ["status", "project_id", "conflicts"],
      "properties": {
        "status": {"enum": ["SAFE_TO_RESUME", "BLOCKED", "RECOVERY_CONFLICT"]},
        "project_id": {"type": "string"},
        "last_verified_action": {"type": ["string", "null"]},
        "next_unverified_action": {"type": ["string", "null"]},
        "missing_approvals": {"type": "array", "items": {"type": "string"}},
        "pending_approvals": {"type": "array", "items": {"type": "string"}},
        "denied_approvals": {"type": "array", "items": {"type": "string"}},
        "stale_evidence": {"type": "array", "items": {"type": "string"}},
        "ledger_events_validated": {"type": "integer", "minimum": 0},
        "conflicts": {"type": "array", "items": {"type": "object"}}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/checkpoint"},
    {"$ref": "#/$defs/approval"},
    {"$ref": "#/$defs/recoveryResult"}
  ]
}
