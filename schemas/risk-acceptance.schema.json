{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PREOS Risk Acceptance",
  "type": "object",
  "required": [
    "acceptance_id",
    "risk_ids",
    "authority",
    "reason",
    "scope",
    "approved_at",
    "expires_at",
    "review_trigger"
  ],
  "properties": {
    "acceptance_id": {
      "type": "string"
    },
    "risk_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "approved_at": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "review_trigger": {
      "type": "string",
      "minLength": 1
    },
    "compensating_controls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
