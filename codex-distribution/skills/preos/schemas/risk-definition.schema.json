{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PREOS risk-definition.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "risk_definition_id": { "type": "string", "minLength": 1 },
    "definition_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "canonical_name": { "type": "string", "minLength": 1 },
    "canonical_key": { "type": "string", "minLength": 1 },
    "dimension": { "type": "string", "enum": ["universal", "industry", "product", "jurisdiction", "architecture"] },
    "category": { "type": "string" },
    "root_cause": { "type": "string" },
    "failure_mechanism": { "type": "string" },
    "provenance_class": { "type": "string" },
    "project_contract_id": { "type": "string" },
    "source_risk_id": { "type": "string" },
    "normalized_definition": { "type": "object" },
    "semantic_review_status": { "type": "string", "enum": ["ACCEPTED_AS_SOURCE_SEMANTICS", "ACCEPTED_BY_HUMAN", "CORRECTED", "HUMAN_REVIEW_REQUIRED"] },
    "source_records": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "source_locations": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "transformation_version": { "type": "string", "minLength": 1 },
    "definition_content_sha256": { "type": "string", "minLength": 1 }
  },
  "required": [
    "risk_definition_id",
    "definition_version",
    "canonical_name",
    "canonical_key",
    "normalized_definition",
    "source_records",
    "source_locations",
    "transformation_version",
    "definition_content_sha256"
  ]
}
