{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PREOS Risk Acceptance",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "readiness_requirement_ids": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "acceptance_id": {
      "type": "string",
      "minLength": 1
    },
    "approval_id": {
      "type": "string",
      "minLength": 1
    },
    "residual_risk": {
      "type": "string",
      "minLength": 1
    },
    "risk_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk_definition_id": {
      "type": "string",
      "minLength": 1
    },
    "definition_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "risk_assessment_id": {
      "type": "string"
    },
    "project_contract_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "scope_id": {
      "type": "string"
    },
    "scope_hash": {
      "type": "string"
    },
    "current_scope_hash": {
      "type": "string"
    },
    "current_definition_version": {
      "type": "string"
    },
    "current_risk_assessment_id": {
      "type": "string"
    },
    "current_authority": {
      "type": "boolean"
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "approved_at": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "type": "string",
      "minLength": 1
    },
    "review_trigger": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "EXPIRED",
        "REVOKED",
        "SUPERSEDED"
      ]
    },
    "revoked_at": {
      "type": "string"
    },
    "revoked_by": {
      "type": "string"
    },
    "revocation_reason": {
      "type": "string"
    },
    "replacement_acceptance_id": {
      "type": "string"
    },
    "compensating_controls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_projection": {
      "type": "object",
      "description": "Unreviewed source input only; cannot establish applicability, evidence, gate state or human authority."
    }
  },
  "required": [
    "acceptance_id",
    "risk_ids",
    "risk_definition_id",
    "definition_version",
    "authority",
    "reason",
    "scope",
    "approved_at",
    "expires_at",
    "review_trigger",
    "status"
  ]
}
