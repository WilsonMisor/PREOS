{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PREOS risk-evolution.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "risk_evolution_id": {
      "type": "string",
      "minLength": 1
    },
    "risk_definition_id": {
      "type": "string",
      "minLength": 1
    },
    "definition_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "risk_assessment_id": {
      "type": "string"
    },
    "source_risk_id": {
      "type": "string"
    },
    "project_contract_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "prevention_strategy": {
      "type": "string",
      "minLength": 1
    },
    "mitigation_strategy": {
      "type": "string",
      "minLength": 1
    },
    "recovery_strategy": {
      "type": "string",
      "minLength": 1
    },
    "regression_protection": {
      "type": "string",
      "minLength": 1
    },
    "evolution_version": {
      "type": "string",
      "minLength": 1
    },
    "maturity_stage": {
      "type": "string",
      "minLength": 1
    },
    "activation_trigger": {
      "type": "string",
      "minLength": 1
    },
    "migration_path": {
      "type": "string",
      "minLength": 1
    },
    "review_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_projection": {
      "type": "object",
      "description": "Unreviewed source input only; cannot establish applicability, evidence, gate state or human authority."
    }
  },
  "required": [
    "risk_evolution_id",
    "risk_definition_id",
    "definition_version",
    "prevention_strategy",
    "mitigation_strategy",
    "recovery_strategy",
    "regression_protection",
    "evolution_version",
    "maturity_stage",
    "activation_trigger",
    "migration_path",
    "review_conditions"
  ]
}
