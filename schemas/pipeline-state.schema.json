{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PREOS Pipeline State",
  "type": "object",
  "required": ["schema_version", "project_id", "updated_at", "state", "current_stage", "last_transition"],
  "properties": {
    "schema_version": {"enum": ["1.2"]},
    "project_id": {"type": "string", "minLength": 1},
    "created_at": {"type": ["string", "null"]},
    "updated_at": {"type": "string", "minLength": 1},
    "state": {"enum": ["UNINITIALIZED", "INGESTING", "INTAKE_BLOCKED", "PLANNING", "PLAN_BLOCKED", "PLAN_APPROVAL_REQUIRED", "APPROVED_FOR_IMPLEMENTATION", "IMPLEMENTING", "IMPLEMENTATION_BLOCKED", "VERIFYING", "VERIFICATION_BLOCKED", "APPROVED_FOR_RELEASE", "RELEASE_BLOCKED", "RELEASED", "OPERATING", "NEEDS_RECONCILIATION", "RECOVERY_CONFLICT"]},
    "current_stage": {"type": "string", "minLength": 1},
    "blueprint_phase": {"type": ["string", "null"]},
    "preos_phase": {"type": ["string", "null"]},
    "project_contract_version": {"type": ["string", "null"]},
    "current_task_packet": {"type": ["string", "null"]},
    "gstack_specialist_stage": {"type": ["string", "null"]},
    "implementation_status": {"type": ["string", "null"]},
    "release_status": {"type": ["string", "null"]},
    "last_transition": {"type": "string", "minLength": 1},
    "last_checkpoint_id": {"type": ["string", "null"]},
    "git_branch": {"type": ["string", "null"]},
    "git_head": {"type": ["string", "null"]},
    "working_tree_fingerprint": {"type": ["string", "null"]},
    "last_verified_action": {"type": ["string", "null"]},
    "next_unverified_action": {"type": ["string", "null"]},
    "pending_test": {"type": ["string", "null"]},
    "pending_build": {"type": ["string", "null"]},
    "pending_migration": {"type": ["string", "null"]},
    "pending_evidence": {"type": ["string", "null"]},
    "active_risk_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "active_control_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "required_approval_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
