{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PREOS risk-definition.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "risk_definition_id": {
      "type": "string",
      "minLength": 1
    },
    "definition_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "canonical_name": {
      "type": "string",
      "minLength": 1
    },
    "canonical_key": {
      "type": "string",
      "minLength": 1
    },
    "dimension": {
      "type": "string",
      "enum": [
        "universal",
        "industry",
        "product",
        "jurisdiction",
        "architecture"
      ]
    },
    "category": {
      "type": "string"
    },
    "root_cause": {
      "type": "string"
    },
    "failure_mechanism": {
      "type": "string"
    },
    "provenance_class": {
      "type": "string"
    },
    "source_risk_id": {
      "type": "string"
    },
    "normalized_definition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canonical_name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "dimension": {
          "type": "string"
        },
        "root_cause": {
          "type": "string"
        },
        "failure_mechanism": {
          "type": "string"
        },
        "trigger_conditions": {
          "type": "string"
        },
        "prevention_strategy": {
          "type": "string"
        },
        "automated_test": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "aliases": {
          "type": "string"
        },
        "affected_components": {
          "type": "string"
        },
        "recovery_patterns": {
          "type": "string"
        },
        "owner_role_pattern": {
          "type": "string"
        },
        "preconditions": {
          "type": "string"
        },
        "business_invariant": {
          "type": "string"
        },
        "expected_correct_behaviour": {
          "type": "string"
        },
        "reconciliation": {
          "type": "string"
        },
        "default_consequences": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "customer": {
              "type": "string"
            },
            "business": {
              "type": "string"
            },
            "security": {
              "type": "string"
            },
            "data_integrity": {
              "type": "string"
            },
            "availability": {
              "type": "string"
            },
            "performance": {
              "type": "string"
            },
            "privacy": {
              "type": "string"
            },
            "legal": {
              "type": "string"
            },
            "operations": {
              "type": "string"
            }
          }
        },
        "control_patterns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prevention": {
              "type": "string"
            },
            "mitigation": {
              "type": "string"
            },
            "implementation": {
              "type": "string"
            }
          }
        },
        "testing_patterns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "automated": {
              "type": "string"
            },
            "load_concurrency": {
              "type": "string"
            },
            "negative": {
              "type": "string"
            },
            "chaos": {
              "type": "string"
            },
            "security": {
              "type": "string"
            },
            "required": {
              "type": "string"
            },
            "failure": {
              "type": "string"
            }
          }
        },
        "monitoring_patterns": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "detection": {
                  "type": "string"
                },
                "observability": {
                  "type": "string"
                },
                "alerts": {
                  "type": "string"
                }
              }
            }
          ]
        }
      },
      "description": "Reusable source knowledge only. Owner is a generic role pattern, never project assignment or acceptance authority."
    },
    "semantic_review_status": {
      "type": "string",
      "enum": [
        "ACCEPTED_AS_SOURCE_SEMANTICS",
        "ACCEPTED_BY_HUMAN",
        "CORRECTED",
        "HUMAN_REVIEW_REQUIRED"
      ]
    },
    "source_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_record": {
            "type": "string"
          },
          "source_heading_name": {
            "type": "string"
          },
          "source_record_sha256": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "scenario": {
            "type": "string"
          },
          "source_line_start": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "transformation_version": {
      "type": "string",
      "minLength": 1
    },
    "definition_content_sha256": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "risk_definition_id",
    "definition_version",
    "canonical_name",
    "canonical_key",
    "normalized_definition",
    "source_records",
    "source_locations",
    "transformation_version",
    "definition_content_sha256"
  ]
}
